<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Sales App (practice)</title>
    <style>
        body { font-family: Segoe UI, Arial, sans-serif; margin: 0; color: #222; }
        .nav { background: #1f3a5f; padding: 12px 24px; }
        .nav a { color: #fff; margin-right: 20px; text-decoration: none; }
        main { padding: 24px; max-width: 1000px; }
        table { border-collapse: collapse; margin-top: 16px; width: 100%; }
        th, td { border: 1px solid #ccc; padding: 6px 10px; text-align: left; }
        th { background: #f0f3f7; }
        td.num { text-align: right; }
        button, select { padding: 6px 12px; margin: 4px 8px 4px 0; }
        .msg { background: #eef6ee; padding: 8px 12px; border-left: 4px solid #3a8a3a; }
        #blazor-error-ui { display: none; position: fixed; bottom: 0; left: 0; right: 0;
            background: #ffe6e6; padding: 12px 24px; border-top: 2px solid #c00; }
        #blazor-error-ui .dismiss { cursor: pointer; float: right; }
    </style>
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <div id="blazor-error-ui">
        An unhandled error has occurred. Check the terminal for details.
        <a href="" class="reload">Reload</a>
        <a class="dismiss">x</a>
    </div>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
